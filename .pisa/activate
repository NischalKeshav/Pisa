#!/usr/bin/env bash
# Source this file to change the current shell's prompt.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    echo "Use: source ${BASH_SOURCE[0]}" >&2
    exit 1
fi

deactivate() {
    if [[ -n "${_PISA_OLD_PS1+x}" ]]; then
        PS1="$_PISA_OLD_PS1"
        unset _PISA_OLD_PS1
    fi
    unset -f deactivate
}

if [[ -z "${_PISA_OLD_PS1+x}" ]]; then
    _PISA_OLD_PS1="${PS1-}"
    PS1="(Pisa) ${PS1-}"
fi
